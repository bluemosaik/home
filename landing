<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>bluemosaik · Discovering awesome GitHub gems</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23F7F5F0'/%3E%3Crect x='8' y='8' width='20' height='20' rx='5' fill='%231D4ED8'/%3E%3Crect x='36' y='8' width='20' height='20' rx='5' fill='%232563EB'/%3E%3Crect x='8' y='36' width='20' height='20' rx='5' fill='%233B82F6'/%3E%3Crect x='36' y='36' width='20' height='20' rx='5' fill='%2393C5FD'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://miaoda.feishu.cn">
<link rel="stylesheet" href="https://miaoda.feishu.cn/fonts/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap">
<style>
  :root{
    --bg:#F7F5F0;
    --surface:#FFFFFF;
    --ink:#18273F;
    --ink-soft:#5A6B85;
    --line:#E6E1D6;
    --blue-900:#1E3A8A;
    --blue-700:#2563EB;
    --blue-500:#3B82F6;
    --blue-300:#93C5FD;
    --blue-200:#BFDBFE;
    --blue-100:#DBEAFE;
    --amber:#F5A623;
    --m1:#1D4ED8; --m2:#2563EB; --m3:#3B82F6; --m4:#60A5FA; --m5:#93C5FD; --m6:#BFDBFE;
    --shadow:0 24px 50px -28px rgba(30,58,138,.35);
    --radius:20px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;
    background:var(--bg);
    color:var(--ink);
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{font-family:"Space Grotesk","Noto Sans SC",sans-serif;letter-spacing:-.01em}
  a{color:inherit}
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
  .mosaic-dots{
    position:absolute;inset:0;pointer-events:none;opacity:.5;
    background-image:radial-gradient(circle at 1px 1px, rgba(37,99,235,.16) 1.5px, transparent 0);
    background-size:26px 26px;
    -webkit-mask-image:radial-gradient(ellipse 60% 60% at 70% 30%, #000 40%, transparent 100%);
    mask-image:radial-gradient(ellipse 60% 60% at 70% 30%, #000 40%, transparent 100%);
  }

  /* ---------- Nav ---------- */
  nav{
    position:sticky;top:0;z-index:50;
    backdrop-filter:blur(10px);background:rgba(247,245,240,.85);
    border-bottom:1px solid var(--line);
  }
  .nav-in{display:flex;align-items:center;justify-content:space-between;height:66px}
  .brand{display:flex;align-items:center;gap:11px;font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:19px}
  .brand-mark{display:grid;grid-template-columns:repeat(2,9px);grid-auto-rows:9px;gap:2px}
  .brand-mark i{width:9px;height:9px;border-radius:2.5px}
  .brand-mark i:nth-child(1){background:var(--m1)}
  .brand-mark i:nth-child(2){background:var(--m3)}
  .brand-mark i:nth-child(3){background:var(--m3)}
  .brand-mark i:nth-child(4){background:var(--m5)}
  .nav-links{display:flex;align-items:center;gap:28px;font-size:15px;font-weight:500}
  .nav-links a{text-decoration:none;color:var(--ink-soft);transition:color .15s}
  .nav-links a:hover{color:var(--blue-700)}
  .nav-cta{
    text-decoration:none;background:var(--ink);color:#fff;padding:9px 16px;border-radius:999px;
    font-size:14px;font-weight:600;transition:transform .15s,background .15s;
  }
  .nav-cta:hover{background:var(--blue-700);transform:translateY(-1px)}
  @media(max-width:720px){.nav-links{display:none}}

  /* ---------- Hero ---------- */
  header.hero{position:relative;overflow:hidden}
  .hero-in{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;padding:88px 0 96px}
  .kicker{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;text-align:center;font-size:13px;font-weight:600;color:var(--blue-700);
    border:1px solid var(--blue-200);background:var(--blue-100);padding:6px 12px;border-radius:999px;letter-spacing:.02em}
  .kicker .dot{width:7px;height:7px;border-radius:50%;background:var(--blue-500);animation:pulse 2.4s infinite}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.8)}}
  .hero h1{font-size:clamp(40px,6vw,66px);line-height:1.05;margin:22px 0 6px;font-weight:700}
  .hero h1 .brand-word{color:var(--blue-700)}
  .hero .tagline{font-size:clamp(17px,2.2vw,20px);color:var(--ink-soft);max-width:520px;margin:14px 0 30px}
  .hero .tagline em{font-style:normal;color:var(--blue-700);font-weight:600}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:9px;padding:13px 22px;border-radius:14px;font-weight:600;font-size:15px;text-decoration:none;transition:transform .15s,box-shadow .15s,background .15s}
  .btn-primary{background:var(--blue-700);color:#fff;box-shadow:0 12px 26px -14px rgba(37,99,235,.8)}
  .btn-primary:hover{background:var(--blue-900);transform:translateY(-2px)}
  .btn-ghost{background:var(--surface);color:var(--ink);border:1.5px solid var(--line)}
  .btn-ghost:hover{border-color:var(--blue-300);transform:translateY(-2px)}
  .btn svg{width:17px;height:17px}

  .hero-art{position:relative;display:flex;justify-content:center;align-items:center}
  .avatar-frame{
    position:relative;width:min(360px,78vw);aspect-ratio:1/1;border-radius:34px;
    background:var(--surface);padding:16px;box-shadow:var(--shadow);transform:rotate(-2deg);
    border:1px solid var(--line);
  }
  .avatar-frame img{width:100%;height:100%;object-fit:cover;border-radius:22px;display:block}
  .avatar-frame::after{
    content:"";position:absolute;inset:-14px;border-radius:40px;z-index:-1;
    background:
      conic-gradient(from 180deg at 100% 0, var(--m1) 0 25%, var(--m5) 0 50%, var(--m2) 0 75%, var(--m6) 0);
    opacity:.35;filter:blur(6px);
  }
  .float-chip{
    position:absolute;background:var(--surface);border:1px solid var(--line);border-radius:14px;
    padding:10px 14px;font-size:13px;font-weight:600;box-shadow:var(--shadow);display:flex;align-items:center;gap:8px;
  }
  .float-chip svg{width:16px;height:16px}
  .chip-a{top:6%;left:-4%}
  .chip-b{bottom:8%;right:-3%}
  .chip-a svg{color:var(--amber)}
  .chip-b svg{color:var(--blue-600,#1D4ED8)}

  .hero-stats{display:flex;gap:34px;margin-top:42px;flex-wrap:wrap}
  .stat .num{font-family:"Space Grotesk",sans-serif;font-size:26px;font-weight:700;color:var(--blue-700);line-height:1.1}
  .stat .lbl{font-size:13px;color:var(--ink-soft)}

  @media(max-width:900px){
    .hero-in{grid-template-columns:1fr;gap:56px;padding:64px 0 72px;text-align:center}
    .hero .tagline{margin-left:auto;margin-right:auto}
    .hero-ctas,.hero-stats{justify-content:center}
    .avatar-frame{transform:none}
    .chip-a{left:-2%}.chip-b{right:-2%}
  }

  /* ---------- Sections ---------- */
  section{padding:84px 0}
  .sec-head{max-width:640px;margin-bottom:46px}
  .sec-head .eyebrow{font-family:"Space Grotesk",sans-serif;font-size:13px;font-weight:600;letter-spacing:.12em;color:var(--blue-700);text-transform:uppercase;margin-bottom:12px}
  .sec-head h2{font-size:clamp(28px,4vw,40px);line-height:1.15;font-weight:700}
  .sec-head p{color:var(--ink-soft);margin-top:12px;font-size:16px}

  /* Who I am */
  #about{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
  .about-text .lead{font-size:21px;line-height:1.6;font-weight:500}
  .about-text .lead b{color:var(--blue-700);font-weight:700}
  .about-text p.body{color:var(--ink-soft);margin-top:16px}
  .pillars{display:grid;gap:14px;margin-top:28px}
  .pillar{display:flex;gap:16px;align-items:flex-start;padding:18px 18px;border:1px solid var(--line);border-radius:16px;background:var(--bg)}
  .pillar .pnum{font-family:"Space Grotesk",sans-serif;font-size:13px;font-weight:600;color:var(--blue-700);border:1.5px solid var(--blue-200);border-radius:10px;min-width:34px;height:34px;display:flex;align-items:center;justify-content:center}
  .pillar h4{font-size:16px;font-weight:700;margin-bottom:2px}
  .pillar p{font-size:14px;color:var(--ink-soft)}
  @media(max-width:860px){.about-grid{grid-template-columns:1fr;gap:40px}}

  /* What I share — categories */
  .cats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .cat{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    padding:26px 24px;position:relative;overflow:hidden;transition:transform .18s,box-shadow .18s;
  }
  .cat:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .cat .tile{width:46px;height:46px;border-radius:13px;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .cat .tile svg{width:24px;height:24px;color:#fff}
  .tile-1{background:var(--m1)} .tile-2{background:var(--m2)} .tile-3{background:var(--m3)}
  .tile-4{background:var(--m4)} .tile-5{background:var(--m5)} .tile-6{background:var(--m6)}
  .cat h3{font-size:18px;font-weight:700;margin-bottom:6px}
  .cat p{font-size:14px;color:var(--ink-soft)}
  .cat .tag{display:inline-block;margin-top:14px;font-size:12px;font-weight:600;color:var(--blue-700);background:var(--blue-100);padding:4px 10px;border-radius:999px}
  @media(max-width:900px){.cats{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.cats{grid-template-columns:1fr}}

  /* How I share — timeline */
  #process{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;counter-reset:step}
  .step{position:relative;padding:0 28px}
  .step:not(:last-child)::after{content:"";position:absolute;top:20px;left:100%;width:calc(100% - 40px);height:2px;background:var(--blue-200)}
  .step .snode{
    counter-increment:step;width:40px;height:40px;border-radius:12px;background:var(--ink);color:#fff;
    display:flex;align-items:center;justify-content:center;font-family:"Space Grotesk",sans-serif;font-weight:700;margin-bottom:16px;
  }
  .step .snode::after{content:counter(step)}
  .step h3{font-size:18px;font-weight:700;margin-bottom:6px}
  .step p{font-size:14px;color:var(--ink-soft);max-width:300px}
  @media(max-width:760px){.steps{grid-template-columns:1fr;gap:26px}.step:not(:last-child)::after{display:none}}

  /* focus — terminal card */
  .focus-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
  .focus-list{display:grid;gap:18px}
  .fitem{display:flex;gap:16px}
  .fitem .ficon{width:40px;height:40px;flex-shrink:0;border-radius:12px;background:var(--blue-100);color:var(--blue-700);display:flex;align-items:center;justify-content:center}
  .fitem .ficon svg{width:20px;height:20px}
  .fitem h4{font-size:16px;font-weight:700;margin-bottom:2px}
  .fitem p{font-size:14px;color:var(--ink-soft)}
  .term{
    background:#0F1B33;border-radius:18px;padding:22px;color:#D7E6FF;font-family:"Space Grotesk","SF Mono",ui-monospace,Menlo,Consolas,monospace;
    font-size:14px;line-height:2;box-shadow:var(--shadow);overflow-x:auto;
  }
  .term .bar{display:flex;gap:7px;margin-bottom:16px}
  .term .bar i{width:11px;height:11px;border-radius:50%;display:block}
  .term .bar i:nth-child(1){background:#F26D6D}.term .bar i:nth-child(2){background:#F5C15A}.term .bar i:nth-child(3){background:#6DD28C}
  .term .cmd{color:#9FC0FF}
  .term .ok{color:#6DD28C}
  .term .dim{color:#7C96C8}
  @media(max-width:860px){.focus-grid{grid-template-columns:1fr;gap:40px}}

  /* CTA */
  .cta-band{
    background:linear-gradient(135deg,#1E3A8A,#2563EB);border-radius:26px;padding:56px 48px;color:#fff;
    display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;position:relative;overflow:hidden;
  }
  .cta-band::after{content:"";position:absolute;right:-30px;top:-30px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.22),transparent 65%)}
  .cta-band h2{font-size:clamp(24px,3.4vw,34px);line-height:1.2;font-weight:700;max-width:520px}
  .cta-band p{color:#D9E6FF;margin-top:8px;max-width:460px}
  .cta-actions{display:flex;gap:14px;flex-wrap:wrap;position:relative;z-index:2}
  .btn-white{background:#fff;color:var(--blue-900)}
  .btn-white:hover{transform:translateY(-2px)}
  .btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.55)}
  .btn-outline:hover{border-color:#fff;transform:translateY(-2px)}

  footer{padding:40px 0 56px}
  .foot{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;color:var(--ink-soft);font-size:14px}
  .foot .brand{color:var(--ink)}
  .foot .social{display:flex;gap:14px}
  .foot .social a{width:38px;height:38px;border-radius:11px;border:1px solid var(--line);background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--ink);transition:transform .15s,border-color .15s}
  .foot .social a:hover{transform:translateY(-2px);border-color:var(--blue-300);color:var(--blue-700)}
  .foot .social svg{width:18px;height:18px}

  :focus-visible{outline:3px solid var(--blue-500);outline-offset:2px;border-radius:6px}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
